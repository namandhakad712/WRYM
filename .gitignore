# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit keys; bench/models.json names env vars instead
.env*
!.env.example

# runtime data (the leaderboard lives in results/, not in the DB)
/db/*.db
/db/*.db-journal

# sandbox / scaffold infra
.vercel
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
server.log
test
prompt

# Skills directory
/skills/

# workspace scratch
/tool-results/
/mini-services/
/examples/
/download/
/scripts/paper/

# prisma client is generated
node_modules/.prisma

# private uploads — never public
upload/
